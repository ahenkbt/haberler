# catfill: keeps the thin/empty menu categories of the PHP news sites fed (turkatahaber/yerel.net.tr shared pool 230, gundemi.org family, fix.tc).
# /docker/php-theme/importer-v5 (catfill.py + targets.json generated by mktargets.py). INSERT-only into twilight-pine portal_rss_items,
# photo-checked, site-scoped dedupe, vatanhaber block terms honoured. Never corporate sites (7/11/61). Remove this file to stop.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
27 1,7,13,19 * * * root flock -n /run/php-theme-importer-catfill.lock timeout 1500 nice -n 10 /docker/php-theme/importer-v5/run.sh daily >> /var/log/php-theme/importer-catfill.log 2>&1
# Panel feeds (admin/editor hmNewsSiteRssFeedRows of every news site) -> twilight-pine; global categories go to the shared pool 230 (all sites), site-exclusive stay on the site.
47 * * * * root flock -n /run/php-theme-importer-catfill-panel.lock env CATFILL_SOURCE=panel timeout 1500 nice -n 10 /docker/php-theme/importer-v5/run.sh daily >> /var/log/php-theme/importer-catfill-panel.log 2>&1
