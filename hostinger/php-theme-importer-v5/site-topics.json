   }
  }
 },
 "classifier": {
  "module": "/docker/php-theme/importer-v5/classifier.py (repo: importer-v5/classifier.py)",
  "entry_points": [
   "decide(cat, site_cats, title, spot, lead, site_id, ai)",
   "site_topic_ok(site_id, title, spot)",
   "cat_rule_ok(cat, title, spot)",
   "mentions_city(province, title, spot)",
   "best_topic(title, spot, lead)",
   "ai_choose(title, spot, choices)"
  ],
  "order": "keyword+source rules -> city/region rule (title/spot must name the province or a district) -> AI chain evren -> nvidia -> gemini -> openai (cheap classify models) only when ambiguous"
 }
}