  "rule": "items on topic sites are copied to the shared general pool (site 230) under the matching category; dedupe per site; never corporate; vatanhaber ban applies",
  "map": {
   "232": {
    "default": "gundem",
    "dunya_topic": "dunya"
   },
   "233": {
    "default": "gundem",
