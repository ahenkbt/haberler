# Per-site RSS importers for the new PHP-theme sites (site-scoped dedupe, feed_id ns<id>-*). Remove this file to stop.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
12,42 * * * * root flock -n /run/php-theme-importer-yerelnet.lock timeout 900 docker run --rm --name php-theme-importer-yerelnet --cpus 0.5 --memory 384m --env-file /docker/php-theme/importer.env -e IMPORT_SITE_SLUG=yerelnet -e IMPORT_FEEDS_FILE=sites/yerelnet.json -e IMPORT_SCOPE_SITE=1 -e IMPORT_MAX_PAGE_FETCH=80 -v /docker/php-theme/importer-v5:/app5:ro php-theme-importer:2 python /app5/gate_run.py >> /var/log/php-theme/importer-yerelnet.log 2>&1
