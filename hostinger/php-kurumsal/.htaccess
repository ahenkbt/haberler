# HM kurumsal PHP — Hostinger public_html
Options -Indexes
RewriteEngine On

# Mevcut dosya/klasör (assets) doğrudan
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Worker'a gidecek yollar Hostinger'da 404 olmasın diye dokunma:
# /api /editor /admin /panel Cloudflare route ile Worker'a gider (DNS proxied A).

RewriteRule ^ index.php [L]
