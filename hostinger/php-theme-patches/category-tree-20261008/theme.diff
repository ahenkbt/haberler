+    public function storiesIn(int $siteId, array $categories, int $limit, int $offset = 0): array
+    {
+        $cats = array_values(array_unique(array_filter(array_map('strval', $categories), static fn (string $c): bool => $c !== '')));
+        if (count($cats) <= 1) {
+            return $this->stories($siteId, $cats[0] ?? '', $limit, $offset);
+        }
+        $cats = array_slice($cats, 0, 150);
+        $limit = max(1, min(60, $limit));
+        $offset = max(0, $offset);
+        $live = [];
+        if ($this->bridge !== null) {
+            $want = array_flip($cats);
+            $live = array_values(array_filter($this->live('', 200), static fn (array $s): bool => isset($want[(string) ($s['category'] ?? '')])));
+            $live = array_slice($live, 0, $offset + $limit);
+        }
+        $in = [];
+        foreach ($cats as $i => $c) {
+            $in[] = ':t' . $i;
+        }
+        $list = implode(',', $in);
+        $sql = str_replace(
+            [' AND c.slug = :cat', ' AND category_slug = :cat'],
+            [' AND c.slug IN (' . $list . ')', ' AND category_slug IN (' . $list . ')'],
+            $this->storySql(true)
+        );
+        $sql .= ' ORDER BY published_at DESC LIMIT :lim OFFSET :off';
+        $stmt = $this->pdo->prepare($sql);
+        $stmt->bindValue('site', $siteId, PDO::PARAM_INT);
+        foreach ($cats as $i => $c) {
+            $stmt->bindValue('t' . $i, $c);
+        }
+        $stmt->bindValue('lim', $live === [] ? $limit : $offset + $limit, PDO::PARAM_INT);
+        $stmt->bindValue('off', $live === [] ? $offset : 0, PDO::PARAM_INT);
+        $stmt->execute();
+        $db = $this->mapList($stmt->fetchAll());
+        return $live === [] ? $db : $this->mergeLive($db, $live, $limit, $offset);
+    }
