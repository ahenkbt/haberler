+    // story dedupe 2026-10-08 (storydup job) ------------------------------------------------------------
+    /** @var array{on: bool, s: array<string, true>}|null */
+    private ?array $dup = null;
+
+    /** Per-site duplicate-variant slugs (hm_story_dup_hidden), APCu 60 s. STORY_DUP_DISABLED=1 = off. */
+    private function dupState(): array
+    {
+        if ($this->dup !== null) {
+            return $this->dup;
+        }
+        $this->dup = ['on' => false, 's' => []];
+        if ($this->currentSite <= 0 || getenv('STORY_DUP_DISABLED') === '1') {
+            return $this->dup;
+        }
+        $k = 'storydup:' . $this->currentSite;
+        if (function_exists('apcu_fetch')) {
+            $v = apcu_fetch($k, $ok);
+            if ($ok && is_array($v)) {
+                return $this->dup = $v;
+            }
+        }
+        try {
+            $stmt = $this->pdo->prepare('SELECT public_slug FROM hm_story_dup_hidden WHERE site_id = :site');
+            $stmt->execute(['site' => $this->currentSite]);
+            $set = [];
+            foreach ($stmt->fetchAll(PDO::FETCH_COLUMN) as $slug) {
+                $set[(string) $slug] = true;
+            }
+            $this->dup = ['on' => true, 's' => $set];
+        } catch (\PDOException) {
+            $this->dup = ['on' => false, 's' => []]; // table missing (dev DB): no effect
+        }
+        if (function_exists('apcu_store')) {
+            apcu_store($k, $this->dup, 60);
+        }
+        return $this->dup;
+    }
+
+    private function dupOn(): bool
+    {
+        return $this->dupState()['on'];
+    }
+
+    /** @param list<array<string, mixed>> $items @return list<array<string, mixed>> */
+    private function dropDup(array $items): array
+    {
+        $set = $this->dupState()['s'];
+        if ($set === []) {
+            return $items;
+        }
+        return array_values(array_filter($items, static fn (array $s): bool => !isset($set[(string) ($s['slug'] ?? '')])));
     }
