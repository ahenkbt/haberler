+    /**
+     * turksav guvenlik 2026-10-08: on the defense tree, saved header-menu roots pointing at TSK / MSB / Jandarma / Emniyet are
+     * folded into ONE "Güvenlik Güçleri" root (its dropdown lists the four). Render time only; the saved menu is not touched.
+     * @param list<array{id: string, label: string, href: string, parentId: string, enabled: bool, icon?: string}> $items
+     * @return list<array{id: string, label: string, href: string, parentId: string, enabled: bool, icon?: string}>
+     */
+    public static function foldSavunmaMenu(array $items): array
+    {
+        if (self::$treeMode !== 'savunma' || self::isOff('guvenlik-gucleri')) {
+            return $items;
+        }
+        $group = self::SAVUNMA_CHILDREN['guvenlik-gucleri'];
+        $out = [];
+        $placed = false;
+        $dropped = [];
+        foreach ($items as $it) {
+            $p = preg_match('#/kategori/([a-z0-9-]+)/?(?:[?\#].*)?$#', strtolower((string) $it['href']), $m) === 1 ? $m[1] : '';
+            if ($p === 'guvenlik-gucleri') {
+                if ($placed) {
+                    continue;
+                }
+                $placed = true;
+            } elseif ($it['parentId'] === '' && in_array($p, $group, true)) {
+                $dropped[$it['id']] = true;
+                if ($placed) {
+                    continue;
+                }
+                $it = ['id' => 'ts-guvenlik-gucleri', 'label' => 'Güvenlik Güçleri', 'href' => '/kategori/guvenlik-gucleri', 'parentId' => '',
+                    'enabled' => true, 'icon' => ''];
+                $placed = true;
+            }
+            $out[] = $it;
+        }
+        // sub-items saved under a folded root would otherwise surface as roots (Menu::roots); the tree dropdown covers them
+        return $dropped === [] ? $out : array_values(array_filter($out, static fn (array $it): bool => !isset($dropped[$it['parentId']])));
+    }
