# Goalgo API — Cloudflare Containers + Neon (API-only portal dist; SPA CF Assets'te).
# git-tracked artifacts/ahenkpress/public/yektube-v2 Worker Assets kaçırırsa Express fallback.
# Context: goalgo/  (wrangler image = ./goalgo/Dockerfile.cloudflare)
# sitemap-urlset-20260902d — GSC web sitemap (plain urlset, no news xmlns)
FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update -y && apt-get install -y --no-install-recommends \
  openssl ca-certificates \
  chromium \
  fonts-liberation \
  libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libgbm1 libasound2 \
  && rm -rf /var/lib/apt/lists/*

ENV CHROMIUM_PATH=/usr/bin/chromium
ENV PORT=3000
ENV YEKTUBE_DB_READ=main
ENV YEKTUBE_DB_WRITE=main
ENV NEWS_DB_READ=main
ENV NEWS_DB_WRITE=main
ENV USE_NATIVE_AI_CALL=true
ENV PG_POOL_MAX=15
ENV PG_POOL_CONNECTION_TIMEOUT_MS=8000
ENV MEDIA_STORAGE_MODE=s3
ENV SITE_PUBLIC_ORIGIN=https://turk.eco
ENV LEGACY_MEDIA_ORIGIN=0
ENV S3_REGION=auto

RUN corepack enable && corepack prepare pnpm@9.15.5 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
RUN test -f tsconfig.base.json
RUN printf '%s\n' 'auto-install-peers=false' 'strict-peer-dependencies=false' > .npmrc
COPY artifacts ./artifacts
COPY lib ./lib
COPY scripts ./scripts
COPY data ./data
COPY işletmeler ./işletmeler

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @workspace/api-server run build

ENV NODE_ENV=production

EXPOSE 3000

CMD ["node", "artifacts/api-server/scripts/start-production.mjs"]
