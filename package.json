{
  "name": "goalgo-yazilim",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:web": "pnpm --dir goalgo run build:web",
    "build:netlify": "node scripts/netlify-root-build.mjs",
    "postinstall": "node scripts/cf-workers-ci-prepare.mjs",
    "build:cloudflare": "node scripts/cloudflare-root-build.mjs",
    "deploy:cloudflare": "pnpm run build:cloudflare && pnpm exec wrangler deploy",
    "cf:dashboard-deploy": "pnpm run deploy:cloudflare",
    "cf:dns-cutover": "node scripts/cf-dns-cutover.mjs",
    "test:worker": "node --test cloudflare/*.test.js goalgo/scripts/copy-render-media-to-r2.test.mjs scripts/ensure-yektube-cloudflare-assets.test.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@neondatabase/serverless": "^1.1.0",
    "aws4fetch": "1.0.20",
    "bcryptjs": "^3.0.3",
    "jose": "^4.15.9",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "wrangler": "file:./tooling/wrangler-shim"
  }
}
