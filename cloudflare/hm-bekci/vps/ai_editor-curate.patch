+# ============================================================ curate mode (no AI writing)
+PICK_SYSTEM = ("Sen bir haber sitesinin manşet editörüsün. Sana başka kaynaklarda yayımlanmış GERÇEK haber adayları verilir. "
+               "Haber uydurma, metin yazma, başlık değiştirme. Yalnızca seçim yap ve her seçilene listeden bir kategori ata. "
+               'Yalnızca JSON döndür: {"secim": [aday numaraları önem sırasıyla], "kategori": {"<aday no>": "<kategori-slug>"}}')
+
+
+def curate_result(it):
+    return dict(ok=True, title=it["title"], spot=it["spot"], paragraphs=list(it["paras"]),
+                checks={"mode": "curate", "problems": []}, model="curate", ratio=1.0)
+
+
+def ai_pick_manset(cfg, cn, picks, todo, sst):
+    cats = sorted(set(list(cn.categories or []) + CATEGORY_ORDER))
+    lines = ["%d) [%s] %s — %s" % (i + 1, p[1]["category_slug"] or "-", (p[1]["title"] or "")[:160], (p[1]["spot"] or "")[:200])
+             for i, p in enumerate(picks)]
+    user = ("Site: %s (konsept: %s; öncelikli kategoriler: %s; konular: %s)\n"
+            "Bu siteye en uygun, en güçlü ve en yeni %d haberi manşet için önem sırasıyla seç.\n"
+            "Kategori listesi: %s\n\nAdaylar:\n%s" % (
+                cn.domain, cn.concept_type, ", ".join(cn.categories or []), ", ".join(list(cn.keywords or [])[:15]),
+                todo, ", ".join(cats), "\n".join(lines)))
+    try:
+        d, model, _ = lib.chat_json(cfg, PICK_SYSTEM, user, max_tokens=600, temperature=0, task="classify")
+    except Exception as ex:
+        log("  [%s] AI manşet seçimi başarısız (%s): puan sırası kullanılıyor" % (cn.site_slug, str(ex)[:120]))
+        sst["ai_pick"] = "fail"
+        return picks[:todo]
+    order = []
+    for x in (d.get("secim") or []) if isinstance(d, dict) else []:
+        try:
+            i = int(x) - 1
+        except Exception:
+            continue
+        if 0 <= i < len(picks) and i not in order:
+            order.append(i)
+    if not order:
+        sst["ai_pick"] = "empty"
+        return picks[:todo]
+    catmap = d.get("kategori") or {}
+    out = []
+    for i in order[:todo]:
+        sc, it, why, near, dev = picks[i]
+        c = str(catmap.get(str(i + 1)) or "").strip().lower()
+        if c in cats and c != (it["category_slug"] or ""):
+            it = dict(it, category_slug=c)
+            why = why + ["ai-kategori:" + c]
+        out.append((sc, it, why + ["ai-seçim"], near, dev))
+    sst["ai_pick"] = "%s %d/%d" % (model, len(out), len(picks))
+    log("  [%s] AI manşet seçimi (%s): %s" % (cn.site_slug, model, [i + 1 for i in order[:todo]]))
+    return out
+
